{
  "name": "playwright-typescript-automation-framework",
  "version": "1.0.0",
  "description": "Portfolio-ready Playwright and TypeScript framework for UI and API test automation with GitHub Actions CI/CD.",
  "scripts": {
    "test": "playwright test",
    "test:env": "cross-env ENV_FILE=.env playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui-suite": "playwright test --grep @ui",
    "test:api-suite": "playwright test --grep @api",
    "test:smoke_list": "playwright test --grep @smoke --list",
    "test:regression_list": "playwright test --grep @regression --list",
    "test:ui-suite_list": "playwright test --grep @ui --list",
    "test:api-suite_list": "playwright test --grep @api --list",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "ui-testing",
    "api-testing",
    "github-actions",
    "page-object-model"
  ],
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
